# Copy to .env for local development. Never commit .env.
NODE_ENV=development
LOG_LEVEL=debug
# local | staging | production. Staging may use test sign-in numbers; production never.
DEPLOY_ENV=local
# Test sign-in numbers with a fixed code and no SMS ("+91…:123456", comma-separated). Refused in production.
# OTP_TEST_NUMBERS=

# Observability (all optional). Traces and metrics go to any OpenTelemetry endpoint (Grafana Cloud in the cloud);
# errors go to Sentry. RELEASE is the git commit the deploy sets, so errors show which version raised them.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 instance-id:token>
# OTEL_SERVICE_NAME=gym-api
# SENTRY_DSN=
# RELEASE=
DATABASE_URL=postgres://gym:gym@localhost:54320/gym
REDIS_URL=redis://localhost:63790
SMTP_URL=smtp://localhost:1025
PORT=3000
CORS_ORIGINS=http://localhost:3001
# Generate with: pnpm --filter @gym/api keys >> .env
JWT_PRIVATE_JWK=
# At least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=
# Local convenience only: lets demo staff sign in without an authenticator app. Never in production.
# STAFF_MFA_REQUIRED=false
# Days an invoice may stay unpaid after its due date before the membership expires.
DUNNING_GRACE_DAYS=7
# Hours after check-in when a member who never checked out stops counting as inside.
CHECKIN_AUTO_OUT_HOURS=3
# Members with this many class no-shows in 30 days cannot book in the app (staff still can). 0 = never.
NO_SHOW_LIMIT=0
# Member messages. Development logs them ("console"); production needs real providers.
# PUSH_PROVIDER=expo            # EXPO_ACCESS_TOKEN only if enhanced push security is on
# WHATSAPP_PROVIDER=cloud       # or "off"; needs WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_TOKEN
# SMS_PROVIDER=msg91            # needs MSG91_AUTH_KEY and MSG91_TEMPLATE_IDS (DLT template id per message key)
# MSG91_TEMPLATE_IDS={"otp":"...","staff_invite":"...","renewal_due":"..."}
# Per-gym sending limit each run (every NOTIFY_POLL_MS milliseconds).
NOTIFY_PER_GYM_PER_RUN=100
