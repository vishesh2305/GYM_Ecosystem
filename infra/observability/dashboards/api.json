{
  "uid": "gym-api",
  "title": "API: traffic, errors and speed",
  "description": "RED metrics of the API per environment: requests, server errors and response times, overall and per route.",
  "tags": ["gym-platform"],
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "production,staging,local",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          },
          {
            "text": "local",
            "value": "local",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Availability, last 30 days",
      "description": "Share of requests without a server error. Target (SLO): 99.9%.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(increase(http_server_request_duration_seconds_count{job=\"$env/gym-api\",http_response_status_code=~\"5..\"}[30d])) or vector(0)) / sum(increase(http_server_request_duration_seconds_count{job=\"$env/gym-api\"}[30d]))",
          "legendFormat": "availability",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.999
              },
              {
                "color": "green",
                "value": 0.9995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "Requests per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"$env/gym-api\"}[$__rate_interval]))",
          "legendFormat": "requests/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "id": 2,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "Server errors",
      "description": "Share of requests answered with 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"$env/gym-api\",http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{job=\"$env/gym-api\"}[$__rate_interval]))",
          "legendFormat": "5xx share",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "Response time p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$env/gym-api\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "id": 4,
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per second by status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"$env/gym-api\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Response time",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$env/gym-api\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$env/gym-api\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$env/gym-api\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Busiest routes",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{job=\"$env/gym-api\",http_route!=\"\"}[$__rate_interval])))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Slowest routes (p95)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, http_request_method, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"$env/gym-api\",http_route!=\"\"}[$__rate_interval]))))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Server errors by route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_request_method, http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"$env/gym-api\",http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}} {{http_request_method}} {{http_route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Client errors by route (4xx)",
      "description": "Many 401/429s can mean a broken app release or abuse.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"$env/gym-api\",http_response_status_code=~\"4..\"}[$__rate_interval])))",
          "legendFormat": "{{http_response_status_code}} {{http_route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Event loop delay p99",
      "description": "Above 0.1 s the process is overloaded or blocked.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (job) (nodejs_eventloop_delay_p99_seconds{job=~\"$env/.*\"})",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Synthetic checks",
      "description": "Sign-in, check-in and payment journeys and the readiness check, run by Grafana Synthetic Monitoring (cloud only).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=~\"gym-$env.*\"}",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "id": 12,
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      }
    }
  ]
}
