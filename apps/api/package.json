{
  "name": "@gym/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsdown",
    "start": "node --import ./dist/instrumentation.mjs dist/main.mjs",
    "start:worker": "node --import ./dist/instrumentation.mjs dist/worker.mjs",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "openapi": "tsx scripts/export-openapi.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@gym/config": "workspace:*",
    "@gym/contracts": "workspace:*",
    "@gym/db": "workspace:*",
    "@gym/domain": "workspace:*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-fastify": "^12.6.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "bullmq": "^6.7.8",
    "fastify": "^5.12.8",
    "ioredis": "^6.1.0",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "testcontainers": "^12.2.2",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15"
  }
}
