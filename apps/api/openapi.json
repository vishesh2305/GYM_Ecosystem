    "/v1/auth/mfa/totp/confirm": {
      "post": {
        "operationId": "confirmTotp",
        "summary": "Finish setup with a first code; returns 10 one-time recovery codes (shown once)",
        "tags": [
          "auth"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
